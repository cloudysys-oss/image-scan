# LLM Gateway（代理至 AFS ModelSpace，見 https://github.com/cloudysys-oss/llm-gateway）
# 結尾不加任何路徑,不要補 /models
GATEWAY_BASE_URL=http://localhost:8080
GATEWAY_API_KEY=
GATEWAY_LABEL_PREFIX=imagescan

# 模型名稱,須為 pipeline/models.py 常數表中的「個體名稱」,逐字照抄
# gemma-4-31b-it：2026-08-10 實測定位階段 bbox grounding 效果良好,已設為預設值(見 README §5、§9)
AFS_MODEL=gemma-4-31b-it
